{
  "compilerOptions": {
    "module": "commonjs", "target": "ES2022", "outDir": "dist",
    "rootDir": "src", "moduleResolution": "node", "strict": true,
    "experimentalDecorators": true, "emitDecoratorMetadata": true,
    "esModuleInterop": true, "skipLibCheck": true
  },
  "include": ["src/**/*.ts"]
}
