    "test:embedded": "node --test tests/embedded.test.cjs",
    "test:harness": "node --test tests/live.test.cjs",
    "import:excel": "node dist/scripts/import-excel.js",
    "seed:asignaciones": "node dist/scripts/seed-assignments.js",
    "seed:desk": "node dist/scripts/seed-desk.js",
