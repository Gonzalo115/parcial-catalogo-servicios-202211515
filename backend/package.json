  },
  "devDependencies": {
    "@electric-sql/pglite": "0.3.10",
    "@nestjs/testing": "11.2.7",
    "@types/express": "5.0.3",
    "@types/node": "22.18.0",
    "@types/pg": "8.15.5",
    "typeorm-pglite": "0.3.4",
