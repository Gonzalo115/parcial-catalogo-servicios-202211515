+ incidentes:[['duracion_estimada_h','Duración estimada en horas','number'],['duracion_real_h','Duración real en horas','number'],['justificacion_clasificacion','Justificación si difiere del mapeo'],['solucion_aplicada','Solución aplicada']],
+ eventos:[['evaluacion','Evaluación del evento'],['incidente_id','ID de incidente existente (opcional)']],
+ problemas:[['causa_raiz','Causa raíz'],['solucion_temporal','Solución temporal'],['error_conocido','Error conocido (si aplica)'],['solucion_definitiva','Solución definitiva']],
+ accesos:[['recurso','Recurso solicitado'],['permiso','Permiso requerido'],['evidencia_provision','Evidencia de provisión o revocación'],['resultado_validacion','Resultado de validación']],
+ servicios:[['resultado_validacion','Validación de la solicitud'],['evidencia_cumplimiento','Evidencia de cumplimiento'],['confirmacion','Confirmación del solicitante']]
+};
+const date=x=>x?new Date(x).toLocaleString():'—';
