+ @Post('ci/:id/relaciones') ciLink(@Req() r:AuthRequest,@Param('id') id:string,@Body() b:any){return this.desk.ciLink(r.user,id,b);}
+ @Post('clases') clase(@Req() r:AuthRequest,@Body() b:any){return this.desk.clase(r.user,b);}
+ @Patch('clases/:id') claseEdit(@Req() r:AuthRequest,@Param('id') id:string,@Body() b:any){return this.desk.clase(r.user,b,id);}
