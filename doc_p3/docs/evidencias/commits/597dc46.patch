+ @Post('colas') queue(@Req() r:AuthRequest,@Body() b:any){return this.desk.saveQueue(r.user,b);}
+ @Patch('colas/:id') queueEdit(@Req() r:AuthRequest,@Param('id') id:string,@Body() b:any){return this.desk.saveQueue(r.user,b,id);}
+ @Post('roles') roles(@Req() r:AuthRequest,@Body() b:any){return this.desk.setRoles(r.user,b);}
